


# ==========================
# Vector Store
# ==========================
FAISS_INDEX_PATH=data/indexes/faiss

# ==========================
# BM25 Index
# ==========================
BM25_INDEX_PATH=data/indexes/bm25

# ==========================
# Document Storage
# ==========================
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed

# ==========================
# Retrieval
# ==========================
TOP_K_BM25=10
TOP_K_VECTOR=10
TOP_K_FINAL=5
SIMILARITY_THRESHOLD=0.65

# ==========================
# Chunking
# ==========================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==========================
# API
# ==========================
HOST=0.0.0.0
PORT=8000

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO


# ==========================
# Gemini
# ==========================
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================
# Embedding Model
# ==========================
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5


